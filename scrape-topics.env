# Centralized scrape topics for social trend research
# Edit this file to change the active topics searched by run-scrape.sh.

# Human-readable topic labels for documentation/reference.
TOPIC_LABELS=(
  "fat loss"
  "anti inflammation"
  "biohacking"
  "skin regeneration"
  "muscle recovery"
  "pain relief"
  "hair growth"
)

# Reddit — subreddit-specific scraping (top posts from this week)
REDDIT_SUBREDDITS=(
  "redlighttherapy"
  "redlighttherapysci"
  "Biohackers"
  "biohacking"
  "longevity"
  "Supplements"
  "SkincareAddiction"
  "tressless"
  "FemaleHairLoss"
  "Peptides"
  "NootropicsDepot"
)
REDDIT_SORT="top"
REDDIT_TIME="week"
REDDIT_LIMIT=15

# TikTok search-first strategy for apidojo/tiktok-scraper
# Use broader platform-native discovery terms, not hashtag pages.
TIKTOK_KEYWORDS=(
  "biohacking"
  "skincare"
  "hair loss"
  "muscle recovery"
  "recovery"
  "wellness"
  "inflammation"
)

TIKTOK_START_URLS=(
  "https://www.tiktok.com/search?q=biohacking"
  "https://www.tiktok.com/search?q=skincare"
  "https://www.tiktok.com/search?q=hair%20loss"
  "https://www.tiktok.com/search?q=muscle%20recovery"
  "https://www.tiktok.com/search?q=recovery"
  "https://www.tiktok.com/search?q=wellness"
  "https://www.tiktok.com/search?q=inflammation"
)

TIKTOK_LOCATION="US"
TIKTOK_SORT_TYPE="RELEVANCE"
TIKTOK_DATE_RANGE="THIS_WEEK"
TIKTOK_MAX_ITEMS=40
TIKTOK_INCLUDE_SEARCH_KEYWORDS=true

# YouTube search queries
# Keep these tighter than TikTok/Instagram terms to avoid junk like towing "recovery" or generic skincare ads.
YOUTUBE_QUERIES=(
  "red light therapy fat loss"
  "red light therapy anti inflammation"
  "red light therapy muscle recovery"
  "red light therapy pain relief"
  "red light therapy hair growth"
  "biohacking"
  "longevity biohacking"
  "red light therapy skincare"
  "recovery biohacking"
  "anti inflammatory wellness"
)

# Instagram hashtags
INSTAGRAM_HASHTAGS=(
  "redlighttherapy"
  "biohacking"
  "skincareroutine"
)
